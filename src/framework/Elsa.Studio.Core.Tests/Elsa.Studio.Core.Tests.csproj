<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net10.0</TargetFrameworks>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <!-- bunit pulls AngleSharp 1.4.0 (GHSA-pgww-w46g-26qg); reference it directly to get the central 1.5.2. -->
        <PackageReference Include="AngleSharp" />
        <PackageReference Include="bunit" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="xunit" />
        <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
        <Compile Include="..\..\testing\StubPermissionService.cs" Link="Authorization\StubPermissionService.cs" />
        <Compile Include="..\..\testing\ApiExceptions.cs" Link="Errors\ApiExceptions.cs" />
    </ItemGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Elsa.Studio.Core\Elsa.Studio.Core.csproj" />
        <ProjectReference Include="..\Elsa.Studio.Shared\Elsa.Studio.Shared.csproj" />
    </ItemGroup>

</Project>
