@using Elsa.Studio.Contracts
@using Elsa.Studio.Models
@using Elsa.Studio.Extensions
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Extensions.DependencyInjection
@using Microsoft.Extensions.Logging
@implements IDisposable
@inject IMenuService MenuService;
@inject IServiceProvider Services
@inject ILogger<NavMenu> Logger

<MudNavMenu Color="Color.Primary" Margin="Margin.Dense" Class="studio-nav">
    @foreach (var (menuItemGroup, menuItems) in _navigation)
    {
        <MudText Typo="Typo.overline" Class="studio-nav__group-label">@menuItemGroup.Text</MudText>

        foreach (var menuItem in menuItems)
        {
            <NavMenuItem MenuItem="menuItem" />
        }
    }
</MudNavMenu>

@code
{
    private IReadOnlyList<MenuNavigationGroup> _navigation = [];

    private AuthenticationStateProvider? _authenticationStateProvider;
    private int _load;

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        // Menu items are filtered by the user's permissions, which can change while the shell stays loaded.
        _authenticationStateProvider = Services.GetService<AuthenticationStateProvider>();
        if (_authenticationStateProvider != null)
            _authenticationStateProvider.AuthenticationStateChanged += OnAuthenticationStateChanged;

        await LoadMenuAsync();
    }

    /// <inheritdoc />
    public void Dispose()
    {
        if (_authenticationStateProvider != null)
            _authenticationStateProvider.AuthenticationStateChanged -= OnAuthenticationStateChanged;
    }

    private async Task LoadMenuAsync()
    {
        var load = ++_load;
        var navigation = await MenuService.GetNavigationAsync();

        // A newer load (e.g. from a later authentication change) wins over one that resolves after it.
        if (load != _load)
            return;

        _navigation = navigation;
    }

    private async void OnAuthenticationStateChanged(Task<AuthenticationState> state)
    {
        // async void: an exception escaping here is unobserved, and in WebAssembly nothing surfaces it, so the
        // user would be left with a silently stale navigation for the rest of the session. Log it instead.
        try
        {
            await InvokeAsync(async () =>
            {
                await LoadMenuAsync();
                StateHasChanged();
            });
        }
        catch (Exception e)
        {
            Logger.LogError(e, "Failed to rebuild the navigation after an authentication state change");
        }
    }
}
